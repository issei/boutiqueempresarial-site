{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/forms/**",
              "components/site/**",
              "components/social/**",
              "ui_kits/site/**",
              "ui_kits/social/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: Inter, Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApplyLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|style|key|ref|className|style|children)$/]",
        "message": "<ApplyLink> doesn't accept that prop. Declared props: children, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|handle|photoSrc|initials|size|verified|mode|style|key|ref|className|style|children)$/]",
        "message": "<AuthorHeader> doesn't accept that prop. Declared props: name, handle, photoSrc, initials, size, verified, mode, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorHeader'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<AuthorHeader> mode must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|variant|size|block|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, href, variant, size, block, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckboxOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|children|error|style|key|ref|className|style|children)$/]",
        "message": "<CheckboxOption> doesn't accept that prop. Declared props: checked, onChange, children, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checklist'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|variant|style|key|ref|className|style|children)$/]",
        "message": "<Checklist> doesn't accept that prop. Declared props: items, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checklist'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:diagnostic|method)$/]",
        "message": "<Checklist> variant must be one of 'diagnostic' | 'method'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Container'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|width|style|key|ref|className|style|children)$/]",
        "message": "<Container> doesn't accept that prop. Declared props: children, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Container'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:body|wide)$/]",
        "message": "<Container> width must be one of 'body' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|children|actions|cta|style|key|ref|className|style|children)$/]",
        "message": "<ContentCard> doesn't accept that prop. Declared props: mode, children, actions, cta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentCard'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ContentCard> mode must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialDivider'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|thickness|mode|gap|style|key|ref|className|style|children)$/]",
        "message": "<EditorialDivider> doesn't accept that prop. Declared props: width, thickness, mode, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialDivider'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<EditorialDivider> mode must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|spaced|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, spaced, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: question, answer."
      },
      {
        "selector": "JSXOpeningElement[name.name='FindingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|children|hoverable|style|key|ref|className|style|children)$/]",
        "message": "<FindingCard> doesn't accept that prop. Declared props: number, title, children, hoverable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|shake|style|key|ref|className|style|children)$/]",
        "message": "<FormStep> doesn't accept that prop. Declared props: children, active, shake, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoldRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:length|gap|style|key|ref|className|style|children)$/]",
        "message": "<GoldRule> doesn't accept that prop. Declared props: length, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|children|style|key|ref|className|style|children)$/]",
        "message": "<ModeTag> doesn't accept that prop. Declared props: mode, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeTag'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ModeTag> mode must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotesBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|style|key|ref|className|style|children)$/]",
        "message": "<NotesBar> doesn't accept that prop. Declared props: label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PainList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<PainList> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|legend|options|value|onChange|error|style|key|ref|className|style|children)$/]",
        "message": "<RadioGroup> doesn't accept that prop. Declared props: name, legend, options, value, onChange, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScaleSelect'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|legend|min|max|value|onChange|error|style|key|ref|className|style|children)$/]",
        "message": "<ScaleSelect> doesn't accept that prop. Declared props: name, legend, min, max, value, onChange, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|rule|style|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: children, tone, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|white|inverse)$/]",
        "message": "<Section> tone must be one of 'cream' | 'white' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectionHighlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SelectionHighlight> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|style|key|ref|className|style|children)$/]",
        "message": "<StepDots> doesn't accept that prop. Declared props: count, active, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepList'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|style|key|ref|className|style|children)$/]",
        "message": "<StepList> doesn't accept that prop. Declared props: steps, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyCta'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|style|key|ref|className|style|children)$/]",
        "message": "<StickyCta> doesn't accept that prop. Declared props: label, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|type|value|onChange|placeholder|multiline|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, error, type, value, onChange, placeholder, multiline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel)$/]",
        "message": "<TextField> type must be one of 'text' | 'email' | 'tel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TldrBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|style|key|ref|className|style|children)$/]",
        "message": "<TldrBlock> doesn't accept that prop. Declared props: title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|size|asImage|logoSrc|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: href, size, asImage, logoSrc, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "ApplyLink": { "replaces": [] },
      "AuthorHeader": { "replaces": [] },
      "Button": { "replaces": [] },
      "CheckboxOption": { "replaces": [] },
      "Checklist": { "replaces": [] },
      "Container": { "replaces": [] },
      "ContentCard": { "replaces": [] },
      "EditorialDivider": { "replaces": [] },
      "Eyebrow": { "replaces": [] },
      "FaqItem": { "replaces": [] },
      "FindingCard": { "replaces": [] },
      "FormStep": { "replaces": [] },
      "GoldRule": { "replaces": [] },
      "ModeTag": { "replaces": [] },
      "NotesBar": { "replaces": [] },
      "PainList": { "replaces": [] },
      "ProgressBar": { "replaces": [] },
      "RadioGroup": { "replaces": [] },
      "ScaleSelect": { "replaces": [] },
      "Section": { "replaces": [] },
      "SelectionHighlight": { "replaces": [] },
      "FooterLink": { "replaces": [] },
      "StepDots": { "replaces": [] },
      "StepList": { "replaces": [] },
      "StickyCta": { "replaces": [] },
      "TextField": { "replaces": [] },
      "TldrBlock": { "replaces": [] },
      "Wordmark": { "replaces": [] }
